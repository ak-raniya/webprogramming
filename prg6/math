<center>
<h2><u><font_color="red">String method</u></h2>
</center>
<center>
<p><b>Java script string method</b></p>
<script>
var name="i am Raniya";
document.write(name);
document .write("<br>");
document.write("Length of string is :");
document.write(name.length);
document.write("<br>");

document.write("Index of first occurance of i in string is:");
document.write(name.indexOf("i"));
document.write("<br>");

document.write("Index of last occurance of h in string is:");
document.write(name.indexOf("h"));
document.write("<br>");

document.write("Index of am in string:");
document.write(name.search("am"));
document.write("<br>");

document.write("Index 0 to 3 print using slice:");
document.write(name.slice(0,4));
document.write("<br>");

document.write("To get substring of string using substring:");
document.write(name.substring(0,8));
document.write("<br>");

document.write("to get substring of string using,substr:");
document.write(name.substr(0,3));
document.write("<br>");

document.write("String to uppercase:");
document.write(name.toUpperCase());
document.write("<br>");

document.write("Repalce Raniya to nada string:");
document.write(name.replace("Raniya","nada"));
document.write("<br>");

document.write("Use trim:");
document.write(name.trim());
document.write("<br>");

document.write("New string that have character 5 on string:");
document.write(name.charAt(5));
document.write("<br>");

document.write("Print numeric ASSI value of character 5 on string:");
document.write(name.charCodeAt(5));
document.write("<br>");
</script>

<center>
<h2><u>Math object</u></h2>
</center>
<p><b>Math object is a build in object,contains basic mathamatical function and constants</b></p>
<script type="text/javascript">
document.write("Value of PI in radian:");
document.write(Math.PI);
document.write("<br>");

document.write("PI in degree:");
document.write(Math.PI*180/Math.PI);
document.write("<br>");

document.write("Value of E");
document.write(Math.E);
document.write("<br>");

document.write("Sign of -3,print 1 if it is positive print -1 if it is negative or print 0 if it is 0:");
document.write(Math.sign(-3));
document.write("<br>");

document.write("Square root of number 8 is:");
document.write(Math.sqrt(8));
document.write("<br>");

document.write("The second power of 8 is:");
document.write(Math.pow(8,2));
document.write("<br>");

document.write("Round the value 4.6 is :");
document.write(Math.round(4.6));
document.write("<br>");

document.write("Round the value 6.7 is :");
document.write(Math.round(6.7));
document.write("<br>");

document.write("Ceil the value 4.4:");
document.write(Math.ceil(4.4));
document.write("<br>");

document.write("Ceil the value 4.6:");
document.write(Math.ceil(4.6));
document.write("<br>");


document.write("Floor valuev of the value 4.4 is:");
document.write(Math.floor(4.4));
document.write("<br>");
</script>
